# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Passcode for the /admin/qrcodes organizer page. This is a light deterrent
# only (it ships inside the public JS bundle) -- do not use it to protect
# anything sensitive. Change it from the default before the event.
NEXT_PUBLIC_ADMIN_PASSCODE=depbbq2026
